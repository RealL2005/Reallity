{
  "name": "reallity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reallity: a native coding-agent harness with FSM, TDD self-healing, and dual-mode UI.",
  "bin": {
    "reallity": "bin/reallity.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build src/cli.ts --outdir dist --target bun"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "figlet": "^1.8.0",
    "ink": "^5.2.1",
    "ink-table": "^3.1.0",
    "react": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.9",
    "@types/figlet": "^1.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "bun": "^1.2.21",
    "typescript": "^5.8.2"
  }
}
